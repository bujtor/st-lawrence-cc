# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Play-Cricket API
PLAY_CRICKET_API_TOKEN=your-play-cricket-api-token
PLAY_CRICKET_SITE_ID=9754

# Sync / Cron
SYNC_API_SECRET=your-sync-api-secret
CRON_SECRET=your-cron-secret

# Captain auth
AVAILABILITY_PIN=1234
# SESSION_SECRET: generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=your-session-secret

# Admin
ADMIN_PIN=1234
